section.get-in-touch(id="contact")
  h1.title.text-primary Dołącz do nas
  form.contact-form.row
    .form-field.col-lg-6
      input#name.input-text.js-input(type='text' required='')
      label.label.text-secondary(for='name') Imię
    .form-field.col-lg-6
      input#email.input-text.js-input(type='email' required='')
      label.label.text-secondary(for='email') E-mail
    .form-field.col-lg-12
      input.btn.btn-outline-primary.submit-btn(type='submit' value='Dołącz')
